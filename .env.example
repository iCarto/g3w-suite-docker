# Public hostname, for docker internal network aliases
WEBGIS_PUBLIC_HOSTNAME=dev.g3wsuite.it

WEBGIS_ADMIN_EMAIL=dev@icarto.es

# Change to "_ssl" to enable https
WEBGIS_SSL=""

# Persistent data folder (projects, database, uploads), mounted into "g3w-suite" container at: `/shared-volume`
WEBGIS_DOCKER_SHARED_VOLUME=./shared-volume

# Set initial admin username and password
# Note that these parameters are only used once during the first project initialization.
# After the first project initialization, you must use the form in the web admin interface to change the credential.
G3WSUITE_ADMIN_USERNAME=admin
G3WSUITE_ADMIN_PASSWORD=admin

##
# 🚨 PostGIS DB
##
G3WSUITE_POSTGRES_USER_LOCAL=g3wsuite
G3WSUITE_POSTGRES_PASS='89#kL8y3D'
G3WSUITE_POSTGRES_DBNAME=g3wsuite
G3WSUITE_POSTGRES_HOST=postgis
G3WSUITE_POSTGRES_PORT=5432

# OPTIONAL: whether activate frontend module
FRONTEND=True

# QGIS Server env variables
# ----------------------------------------------------

# To use PostgreSql Service, mounted into postgis container at: `./secrets/pg_service.conf`,
PGSERVICEFILE=/pg_service/pg_service.conf

QGIS_SERVER_LOG_FILE=/shared-volume/QGIS/error.log
QGIS_SERVER_LOG_LEVEL=2

# Extra QGIS env variables.
# Every QGIS environment variables available as specified on manual
# https://docs.qgis.org/3.22/en/docs/server_manual/config.html#environment-variables
# can be set, important is remember to add them to `docker-compose.yml`.
QGIS_SERVER_CACHE_SIZE=512
# Number of threads to use when parallel rendering is activated. If value is -1 uses the number of processor cores.
QGIS_SERVER_MAX_THREADS=-1
# Activates parallel rendering for WMS GetMap requests. It’s disabled (false) by default.
QGIS_SERVER_PARALLEL_RENDERING=false
# Defines whether a group separator (e.g. thousand separator) should be used for numeric values (e.g. in GetFeatureInfo responses). The default value is 0.
QGIS_SERVER_SHOW_GROUP_SEPARATOR=false
# This is an option at the project level to improve project read time by using the vector layer extents defined in the project metadata and disabling the check for PostgreSQL/PostGIS layer primary key uniqueness.
QGIS_SERVER_TRUST_LAYER_METADATA=false
# Limit the maximum size returned by a GetMap
QGIS_SERVER_WMS_MAX_HEIGHT=5000
QGIS_SERVER_WMS_MAX_WIDTH=5000
QGIS_SERVER_PROJECT_CACHE_STRATEGY=off

# Optional Elastic host override (default: http://elasticsearch:9200)
#G3WSUITE_ELASTIC_HOST=http://elasticsearch:9200

# Gunicorn settings
# ---------------------------------------------------------
# Timeout for Gunicorn instances. In some cases you may consider increasing this value to 240 or higher to prevent 502 errors in nginx.
G3WSUITE_GUNICORN_TIMEOUT=120
G3WSUITE_GUNICORN_NUM_WORKERS=3
G3WSUITE_GUNICORN_MAX_REQUESTS=200
G3WSUITE_DEBUG=False
TILESTACHE_CACHE_TYPE='Disk'

# *Important*: remember to add this env vars also to docker-compose.yml
